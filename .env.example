# ─── Switchpost Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.

# ── Core ─────────────────────────────────────────────────────
# SQLite only. The file is created and migrated automatically on first run.
# Optional — defaults to sqlite://data/switchpost.db when unset.
# Any other scheme (postgres://, mysql://, …) is rejected at startup: no such
# driver is linked into this binary.
DATABASE_URL=sqlite://data/switchpost.db?mode=rwc

# ── Auth ────────────────────────────────────────────────────
# Single-user password gate. Auto-generated on first run if unset
# (persisted to ~/.switchpost/.env). Set explicitly for deployments.
# APP_PASSWORD=change-me-to-a-strong-password

# ── Server ──────────────────────────────────────────────────
# APP_URL is the public-facing URL of your instance.
# Used for OAuth redirect URIs: {APP_URL}/api/auth/callback
# Default: https://localhost:6543
#
# ⚠️  IMPORTANT: Instagram-Standalone and Threads (Meta) REQUIRE HTTPS.
#     They do NOT support http:// redirect URIs, even for localhost.
#     The server auto-generates a self-signed cert when APP_URL starts with https://.
#     For production, use a real cert via tunnel (ngrok/cloudflare) or reverse proxy.
#
# For self-hosting behind a tunnel/proxy, set to your public URL:
#   APP_URL=https://switchpost.yourdomain.com
APP_URL=https://localhost:6543

# BIND_HOST controls which network interface the server binds to.
# Default: 127.0.0.1 (loopback only — recommended for single-user)
# Set to 0.0.0.0 to expose on all interfaces (LAN access). Ensure
# APP_PASSWORD is strong and the port is firewalled if you do this.
# BIND_HOST=127.0.0.1

# FRONTEND_URL controls CORS allowed origins AND the CSRF allow-list.
# Default: same as APP_URL (recommended for single-origin deployment)
# FRONTEND_URL=https://localhost:6543

# JWT secret for auth tokens (auto-derived from APP_PASSWORD if not set)
# JWT_SECRET=your-secret-key-here

# ── Security (Recommended) ──────────────────────────────────
# 64 hex chars (32 bytes) — encrypts OAuth tokens at rest
# TOKEN_ENCRYPTION_KEY=

# ── Outbound requests (webhooks, RSS) ────────────────────────
# The app FETCHES webhook receiver URLs and RSS feed URLs on your behalf.
# By default it refuses a local or private address (127.0.0.1, 10.x,
# 192.168.x, 169.254.169.254 — the cloud metadata address — and the same
# ranges reached through a DNS name), because that address is an SSRF
# target: a webhook pointed at the metadata service reads the instance
# credentials and hands them back through the test endpoint.
#
# Set this to 1 if you really do want a receiver on your own machine or
# your LAN (an n8n on localhost, a receiver on 192.168.1.10).
# ALLOW_PRIVATE_OUTBOUND_URLS=1

# ── Frontend serving (Optional) ─────────────────────────────
# SERVE_FRONTEND=true            # set to false for API-only mode
# FRONTEND_DIR=                  # serve from filesystem path (dev mode)

# ── X / Twitter ─────────────────────────────────────────────
# Option 1: Cookie auth (recommended — enables full GraphQL API)
# X_AUTH_TOKEN=
# X_CT0=
# Option 2: OAuth 2.0 (limited to Twitter API v2)
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# ── Reddit ──────────────────────────────────────────────────
# Option 1: Cookie auth (recommended — enables voting, moderation)
# Cookies are auto-extracted from browser, or submit via web form.
# Option 2: OAuth (script app)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# Option 3: Pre-obtained tokens
# REDDIT_ACCESS_TOKEN=
# REDDIT_REFRESH_TOKEN=

# ── LinkedIn ────────────────────────────────────────────────
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Opt-in to the READ path (feed import, li_get_posts, comment listing).
# `r_member_social` needs LinkedIn's "Read member's social" product enabled
# on the app; when that product is absent LinkedIn answers the authorize
# request with "Bummer, something went wrong" before any consent screen,
# which breaks PUBLISHING too. So the scope is off by default and this flag
# is what turns it on — set it only after enabling the product.
# LINKEDIN_ENABLE_MEMBER_SOCIAL_READ=1

# ── Facebook / Instagram ────────────────────────────────────
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# The `instagram` provider (Graph API) reads INSTAGRAM_CLIENT_ID/SECRET —
# normally the same Meta app id/secret as FACEBOOK_CLIENT_ID/SECRET.
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# The `instagram-standalone` provider reads INSTAGRAM_APP_ID/APP_SECRET.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# ── Threads ─────────────────────────────────────────────────
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# ── YouTube / Google ────────────────────────────────────────
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# One id/secret pair serves the whole Google Suite, CONNECTED AS FOUR
# separate channels rather than one:
#
#   `google`    — YouTube + Gmail + Calendar
#   `gmail`     — Gmail on its own
#   `calendar`  — Calendar on its own
#   `drive`     — Google Drive on its own
#
# Why the split is mandatory: Google's authorize endpoint refuses
# `auth/youtube*` and `auth/drive*` in ONE consent
# ("This request contains scopes that cannot be requested together"), so a
# single `google` integration can never carry a Drive grant. Narrowing the
# unified provider to YouTube+Gmail+Calendar is what makes it connectable
# at all, and the separate `drive` connect is what keeps the MCP Drive
# tools working.

# ── TikTok ──────────────────────────────────────────────────
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=

# ── Pinterest ───────────────────────────────────────────────
# PINTEREST_CLIENT_ID=
# PINTEREST_CLIENT_SECRET=

# ── Discord ─────────────────────────────────────────────────
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=

# ── Slack ───────────────────────────────────────────────────
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# ── Telegram ────────────────────────────────────────────────
# Bot API (comma-separated tokens for multi-bot)
# TELEGRAM_BOT_TOKENS=
# User client (Grammers — for personal account automation)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_DIR=./data/telegram

# ── WhatsApp ────────────────────────────────────────────────
# WHATSAPP_STORE_DIR=./data/whatsapp

# ── Bluesky ─────────────────────────────────────────────────
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=

# ── Mastodon ────────────────────────────────────────────────
# MASTODON_CLIENT_ID=
# MASTODON_CLIENT_SECRET=
# MASTODON_INSTANCE_URL=

# ── Medium ──────────────────────────────────────────────────
# MEDIUM_ACCESS_TOKEN=

# ── Dev.to ──────────────────────────────────────────────────
# DEVTO_API_KEY=

# ── Hashnode ────────────────────────────────────────────────
# HASHNODE_API_KEY=

# ── GitHub ──────────────────────────────────────────────────
# GITHUB_TOKEN=

# ── Media Storage ───────────────────────────────────────────
# MEDIA_DIR=./uploads
